            <!-- mini cart start -->
            <div class="sidebar-cart-active">
                <div class="sidebar-cart-all" >
                    <a class="cart-close" href="#"><i class=" ti-close "></i></a>
                    <div class="cart-content" >
                        <h3>Shopping Cart</h3>
                        <ul>
                             <% if (Session["username"] != null) { %>

                            <asp:Repeater ID="cart" runat="server" >
                                <ItemTemplate>
                            <li class="single-product-cart">
                                <div class="cart-img">
                                    <a href="#">
                                        <asp:Image ID="Image1" runat="server" ImageUrl='<%# "Admin/assets/upload/" + Eval("F_img") %>' />   </a>
                                </div>
                                <div class="cart-title">
                                    <h4><a href="#"><%# Eval("P_name") %></a></h4>
                                    <%--<span><%# Eval("Quantity") %>× $<%# Eval("Price") %></span>--%>
                                    <span>
    <%# Eval("Quantity") %> × $<%# Eval("Price") %> &nbsp;=&nbsp;
    <asp:Label ID="totlbl" runat="server" Text='<%# string.Format("{0:C}", Convert.ToInt32(Eval("Quantity")) * Convert.ToDecimal(Eval("Price"))) %>'></asp:Label>
</span>
                                </div>
                                <div class="cart-delete">
                                    <a href="#">×</a>
                                </div>
                            </li>
                                    </ItemTemplate>
                                </asp:Repeater>
                           
                        </ul>
                        <div class="cart-total">
                            <h4>Subtotal: <span>$<asp:Label ID="lblSubtotal" runat="server" Text="Subtotal: ₹0.00"></asp:Label></span></h4>
                        </div>
                         <% } else { %>
          <h4>cart is empty</h4>
    <% } %>
                        <div class="cart-checkout-btn">
                            <a class="btn-hover cart-btn-style" href="cart.aspx">view cart</a>
                            <a class="no-mrg btn-hover cart-btn-style" href="checkout.aspx">checkout</a>
                        </div>
                    </div>
                </div>
